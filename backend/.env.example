# Copy to backend/.env. Never commit the real .env file.

# Local development (leave DEBUG=True, no SECRET_KEY needed)
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production values go in Render's dashboard, not here
# SECRET_KEY=generate-a-long-random-string
# DEBUG=False
# ALLOWED_HOSTS=your-app.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# DATABASE_URL=postgres://...  (Render sets this automatically)
# SECURE_SSL_REDIRECT=True

# Optional switches
# COMMENTS_ENABLED=false              turn comment posting off everywhere
# COMMENTS_DISABLED_CAMPUSES=towson   turn it off for some campuses only
# SYNC_CAMPUSES=umd                   load only these campuses on deploy (empty = all)
