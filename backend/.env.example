# Copy to backend/.env — never commit the real .env file.

# Local development (leave DEBUG=True, no SECRET_KEY needed)
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production — fill these in on Render's dashboard, not here
# SECRET_KEY=generate-a-long-random-string
# DEBUG=False
# ALLOWED_HOSTS=your-app.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# DATABASE_URL=postgres://...  (Render sets this automatically)
# SECURE_SSL_REDIRECT=True
