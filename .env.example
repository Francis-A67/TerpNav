# Copy to .env in the project root for local development.
VITE_API_URL=http://localhost:8000

# Shows the Towson campus and the campus switcher. Leave it out (or set it to
# anything but "true") to show UMD only. On the live site this is set in
# Vercel's Environment Variables, followed by a redeploy.
VITE_ENABLE_TOWSON=true
